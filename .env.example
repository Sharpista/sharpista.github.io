# Copie este arquivo para `.env.local` e preencha os valores desejados.
# IMPORTANTE: variáveis VITE_ são embutidas no bundle público e não são seguras
# para guardar segredos. Use apenas endpoints públicos, como o do Formspree.

# Endpoint público do formulário (Formspree) — ex.: https://formspree.io/f/abcdwxyz
VITE_FORMSPREE_ENDPOINT=

# Canais de contato exibidos no site (opcional por canal)
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
